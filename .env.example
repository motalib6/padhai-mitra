# Firebase web-app config (console.firebase.google.com -> your project -> web app)
# Copy this file to `.env` and fill in your values. NEVER commit `.env`.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: reCAPTCHA v3 site key for App Check in production builds.
# Leave empty in local dev — the App Check debug provider is used instead.
VITE_APPCHECK_SITE_KEY=
